---
// Documentation shell. Content and identity remain supplied by the existing site data.
import '../styles/documentation.css';
interface Props { name: string }
const { name } = Astro.props;
const sections = [
  ['overview', 'Overview'],
  ['experience', 'Experience'],
  ['projects', 'Projects'],
  ['certifications', 'Certifications'],
  ['contact', 'Contact'],
];
---
<div class="documentation">
  <a class="skip-link btn btn-primary" href="#main">Skip to content</a>
  <div class="documentation-shell">
    <aside class="documentation-sidebar" aria-label="Portfolio navigation">
      <p class="documentation-name">{name}</p>
      <nav class="documentation-nav" aria-label="Sections">
        <ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
      </nav>
    </aside>
    <div class="documentation-body">
      <details class="documentation-mobile-sections">
        <summary>Sections</summary>
        <nav class="documentation-nav" aria-label="Sections">
          <ul>{sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
        </nav>
      </details>
      <main id="main" tabindex="-1"><slot /></main>
      <slot name="footer" />
    </div>
  </div>
</div>
<script>
  import '../scripts/documentation-navigation.js';
  // Keep every link in the page flow when the sidebar cannot fit the viewport,
  // including after font loading, text enlargement or viewport resizing.
  const sidebar = document.querySelector<HTMLElement>('.documentation-sidebar');
  if (sidebar) {
    const updateSticky = () => {
      const top = parseFloat(getComputedStyle(sidebar).top) || 0;
      sidebar.classList.toggle('is-too-tall', sidebar.scrollHeight + top * 2 > window.innerHeight);
    };
    window.addEventListener('resize', updateSticky);
    if ('ResizeObserver' in window) new ResizeObserver(updateSticky).observe(sidebar);
    updateSticky();
  }
</script>
