---
// Documentation shell. Content and identity remain supplied by the existing site data.
import '../styles/documentation.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import type { Site } from '../lib/site';
interface Props { profile: Site['profile'] }
const { profile } = Astro.props;
const role = profile.headline.split('|')[0].trim();
const sections: [string, string, IconName][] = [
  ['overview', 'Overview', 'home'],
  ['experience', 'Experience', 'briefcase'],
  ['projects', 'Projects', 'code'],
  ['certifications', 'Certifications', 'shield'],
  ['contact', 'Contact', 'mail'],
];
---
<div class="documentation">
  <a class="skip-link btn btn-primary" href="#main">Skip to content</a>
  <div class="documentation-shell">
    <aside class="documentation-sidebar" aria-label="Portfolio navigation">
      <div class="sidebar-identity"><p class="documentation-name">{profile.name}</p><p class="documentation-role">{role}</p></div>
      <nav class="documentation-nav" aria-label="Sections">
        <ul>{sections.map(([id, label, icon]) => <li><a href={`#${id}`}><Icon name={icon} size={19} /><span>{label}</span></a></li>)}</ul>
      </nav>
      <div class="sidebar-cv">
        {profile.cvUrl ? <a class="sidebar-cv-link" href={profile.cvUrl}><Icon name="download" />Download CV</a> : <p class="sidebar-cv-pending"><Icon name="download" />CV coming soon</p>}
      </div>
      <div class="sidebar-location"><Icon name="globe" size={21} /><div><p>{profile.location}</p><p>{profile.availability}</p></div></div>
    </aside>
    <div class="documentation-body">
      <details class="documentation-mobile-sections">
        <summary><span class="mobile-identity">{profile.name}<small>{role}</small></span><span class="mobile-menu-label"><Icon name="menu" />Sections</span></summary>
        <nav class="documentation-nav" aria-label="Sections">
          <ul>{sections.map(([id, label, icon]) => <li><a href={`#${id}`}><Icon name={icon} size={19} /><span>{label}</span></a></li>)}</ul>
        </nav>
      </details>
      <main id="main" tabindex="-1"><slot /></main>
      <slot name="footer" />
    </div>
  </div>
</div>
<script>
  import '../scripts/documentation-navigation.js';
  // Keep every link in the page flow when the sidebar cannot fit the viewport,
  // including after font loading, text enlargement or viewport resizing.
  const sidebar = document.querySelector<HTMLElement>('.documentation-sidebar');
  if (sidebar) {
    const updateSticky = () => {
      const top = parseFloat(getComputedStyle(sidebar).top) || 0;
      sidebar.classList.toggle('is-too-tall', sidebar.scrollHeight + top * 2 > window.innerHeight);
    };
    window.addEventListener('resize', updateSticky);
    if ('ResizeObserver' in window) new ResizeObserver(updateSticky).observe(sidebar);
    updateSticky();
  }
</script>
