---
import { noJsEmail } from '../lib/format';
import type { Site } from '../lib/site';
interface Props { contact: Site['contact']; availability: string; hide: boolean }
const { contact, availability } = Astro.props;
const email = `${contact.emailUser}@${contact.emailDomain}`;
---
<section id="contact" aria-labelledby="h-contact" tabindex="-1">
  <div class="wrap contact-layout">
    <div><h2 id="h-contact">Contact</h2>{contact.heading && <p class="contact-lead">{contact.heading}</p>}<p class="contact-availability">{availability}</p></div>
    <div class="contact-links">
      {contact.emailConfirmed && <>
        <a class="email-link" href={`mailto:${email}`}>{email}</a>
        <div class="copyrow"><output class="sr-only" id="email-text" data-email-confirmed="true" data-u={contact.emailUser} data-d={contact.emailDomain}>{email}<noscript>{noJsEmail(contact.emailUser, contact.emailDomain)}</noscript></output><button id="copy-btn" class="copy-btn" type="button" hidden aria-label="Copy email address"><span class="lbl">Copy email</span></button></div>
        <p id="copy-status" class="copy-status" role="status" aria-live="polite"></p>
      </>}
      {contact.linkedinUrl && <a class="soc-link" href={contact.linkedinUrl}>LinkedIn ↗</a>}
    </div>
  </div>
</section>
