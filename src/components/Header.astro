---
interface Props { name: string; base?: string }
const { name, base = '' } = Astro.props;
const nav = [['overview','Overview'],['projects','Projects'],['experience','Experience'],['certifications','Certifications'],['contact','Contact']];
---
<header class="site-head">
  <div class="wrap header-inner">
    <a class="brand" href={`${base}#overview`}>{name}</a>
    <nav aria-label="Primary">
      <details class="nav-disclosure" open>
        <summary aria-controls="section-links">Menu</summary>
        <ul id="section-links" class="nav-links">{nav.map(([id,label]) => <li><a href={`${base}#${id}`}>{label}</a></li>)}</ul>
      </details>
    </nav>
  </div>
</header>
