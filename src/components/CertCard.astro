---
// One credential card in the Certifications grid.
import type { Cert } from '../lib/site';
interface Props { cert: Cert }
const { cert: c } = Astro.props;
const micro = c.kind === 'microcredential';
---
<li class:list={['cert', { micro }]}>
  <div class="cert-copy">
    <h3>{c.name}</h3>
    <p class="issuer">{c.issuer}</p>
    <dl class="dates">
      <div><dt>Issued</dt><dd>{c.datesConfirmed ? c.issued : 'Pending confirmation'}</dd></div>
      <div><dt>Expires</dt><dd>{c.datesConfirmed ? c.expires : 'Pending confirmation'}</dd></div>
    </dl>
  </div>
  <div class="cert-meta"><span class="kind">{micro ? 'Microcredential' : 'Certification'}</span></div>
  <div class="foot">
    {c.credlyUrl
      ? <a class="verify" href={c.credlyUrl} aria-label={`Verify ${c.name} on Credly`} target="_blank" rel="noreferrer">Verify on Credly</a>
      : <span class="verify">Verify on Credly · Coming soon</span>}
  </div>
</li>
