---
import type { Site } from '../lib/site';
interface Props { profile: Site['profile']; draft: boolean; certifications: Site['certifications'] }
const { profile, draft } = Astro.props;
---
<section class="hero" aria-labelledby="hero-name">
  <div class="wrap">
    <div class="hero-surface">
      <p class="eyebrow">Overview</p>
      <p class="role-label">{profile.roleLabel}</p>
      <h1 id="hero-name">{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <div class="ctas"><a class="btn btn-primary" href="#projects">View selected work</a></div>
      <div class="hero-meta"><p>{profile.location}</p><p>{profile.availability}</p></div>
      {draft && <p class="hero-draft-status">Draft — pending final review.</p>}
    </div>
  </div>
</section>
