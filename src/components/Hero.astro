---
import Icon from './Icon.astro';
import type { Site } from '../lib/site';
interface Props {
  profile: Site['profile']; draft: boolean; contactPending: boolean;
  certifications: Site['certifications']; focusAreas: Site['focusAreas'];
}
const { profile, draft, contactPending, certifications, focusAreas } = Astro.props;
const featured = certifications.filter((cert) => cert.featured).slice(0, 4);
---
<section id="hero" class="hero" aria-labelledby="hero-name">
  <div class="wrap">
    <p class="overview-eyebrow">Overview</p>
    <div class="overview-intro">
      <div>
        <h1 id="hero-name">{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="tagline">{profile.tagline}</p>
      </div>
    </div>
    <div class="overview-meta">
      <div class="overview-location"><Icon name="pin" size={31} /><div><p>{profile.location}</p><p>{profile.availability}</p></div></div>
      <a class="overview-credentials" href="#certifications"><Icon name="shield" size={34} /><span>{featured.map((cert) => <span>{cert.short || cert.name}</span>)}<span class="credential-link-label">View credentials →</span></span></a>
    </div>
    {focusAreas.length > 0 && <div class="overview-focus">
      <h2>Core Focus</h2>
      <ul>{focusAreas.map((focus) => <li><Icon name={focus.icon} size={30} /><h3>{focus.title}</h3><p>{focus.description}</p></li>)}</ul>
    </div>}
    <div class="overview-actions"><a class="overview-contact" href="#contact"><Icon name="mail" />Contact me</a>{profile.cvUrl && <a href={profile.cvUrl}><Icon name="download" />Download CV</a>}
      {draft && <p class="hero-draft-status">{contactPending && !profile.cvUrl ? 'Draft — contact details and CV pending.' : 'Draft — pending final review.'}</p>}
    </div>
  </div>
</section>
