---
// One continuing role with separately dated tracks and confirmed responsibilities.
import type { Site } from '../lib/site';
interface Props { experience: Site['experience'] }
const { experience } = Astro.props;
---
<section id="experience" aria-labelledby="h-exp" tabindex="-1">
  <div class="wrap">
    <div class="sh"><h2 id="h-exp">Experience</h2></div>
    {experience.map((e) => (
      <article class="experience-entry">
        <div class="experience-heading">
          <div>
            <h3>{e.role}</h3>
            <p class="experience-employer">{e.employer}</p>
          </div>
          <p class="experience-tenure">{e.period}</p>
        </div>
        {e.tracks.length > 0 && (
          <ul class="experience-tracks" role="list" aria-label="Scope evolution">
            {e.tracks.map((t) => (
              <li class="experience-track">
                <h4>{t.title}</h4>
                <p class="experience-track-period">{t.period}</p>
                {t.responsibilities.length > 0 && (
                  <ul class="experience-responsibilities">
                    {t.responsibilities.map((responsibility) => <li>{responsibility}</li>)}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<style>
  .experience-entry + .experience-entry {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .experience-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: .5rem 1rem;
  }
  h3 { font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
  .experience-employer,
  .experience-tenure { color: var(--muted); font-size: .9375rem; line-height: 1.5; }
  .experience-employer { margin-top: .25rem; }
  .experience-tracks { margin-top: 1.375rem; list-style: none; }
  .experience-track { position: relative; min-width: 0; margin: 0; padding: 0 1rem; border-left: 2px solid var(--line-2); }
  .experience-track + .experience-track { margin-top: 1.125rem; }
  .experience-track::before { position: absolute; top: .42rem; left: -5px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); content: ""; }
  h4 { font-size: 1.0625rem; font-weight: 600; line-height: 1.5; }
  .experience-track-period { margin-top: .25rem; color: var(--muted); font: 550 .8125rem/1.5 var(--mono); }
  .experience-responsibilities {
    margin-top: .5rem;
    padding-left: 1.25rem;
    list-style: disc;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .experience-responsibilities li + li { margin-top: .25rem; }
  @media (min-width: 768px) {
    .experience-tracks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
    .experience-track + .experience-track { margin-top: 0; }
  }
  @media (max-width: 767.98px) {
    .experience-tracks { margin-top: 1.125rem; }
  }
</style>
